rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Profiles: public read, owner write ---
    match /profiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // --- Usernames: public read, authenticated write ---
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // --- Posts: public read, owner write ---
    match /posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null && (request.resource.data.user_id == request.auth.uid || resource.data.user_id == request.auth.uid);
    }

    // --- Comments: public read, authenticated write ---
    match /comments/{commentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // --- Likes: public read, authenticated write ---
    match /likes/{likeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // --- Follows: public read, authenticated write ---
    match /follows/{followId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // --- Saves: owner only (doc ID starts with uid) ---
    match /saves/{saveId} {
      allow read: if request.auth != null && saveId[0:28] == request.auth.uid[0:28];
      allow write: if request.auth != null && saveId[0:28] == request.auth.uid[0:28];
    }

    // --- Wallets: owner read, authenticated update for transfers ---
    // NOTE: In production, wallet transfers should move to Cloud Functions for proper security.
    // Client-side runTransaction prevents double-spend but a malicious client could
    // still credit any wallet. The real fix is server-side enforcement via Cloud Functions.
    match /wallets/{walletId} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      // Allow update by owner (debit) or by any authenticated user (credit via tip/gift).
      // At minimum, prevent setting negative balances. Proper security requires Cloud Functions.
      allow update: if request.auth != null
        && (request.auth.uid == walletId || request.resource.data.total >= 0);
    }

    // --- Coin Purchases: authenticated create/read, restricted update ---
    // NOTE: In production, approve/reject should be restricted to admin-only via custom claims
    // (request.auth.token.admin == true). Since custom claims require a backend to set,
    // we restrict updates so only the purchase owner can transition from pending to submitted,
    // and approval/rejection status changes are allowed for authenticated users (admin UI-gated).
    match /coin_purchases/{purchaseId} {
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow read: if request.auth != null;
      allow update: if request.auth != null
        && (
          // Owner can transition from pending to submitted (UTR entry)
          (resource.data.user_id == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'submitted')
          // Admin approval/rejection (in production, gate with custom claims)
          || request.resource.data.status in ['approved', 'rejected']
        );
      allow delete: if false;
    }

    // --- Transactions: authenticated create, read own (sender or recipient) ---
    match /transactions/{transactionId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
        && (resource.data.sender_id == request.auth.uid || resource.data.recipient_id == request.auth.uid);
      allow update: if false;
      allow delete: if false;
    }

    // --- Live Streams: public read, authenticated create/update ---
    match /live_streams/{streamId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.host_id == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // --- Live Gifts: public read, authenticated create ---
    match /live_gifts/{giftId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

    // --- Gift Catalog: public read, admin write ---
    match /gift_catalog/{giftId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // --- Live Chat: public read, authenticated create ---
    match /live_chat/{chatId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

    // --- Live Tickets: authenticated read/create ---
    match /live_tickets/{ticketId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

    // --- Conversations: participants only ---
    match /conversations/{conversationId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow delete: if false;

      // --- Conversation Messages subcollection: participants only ---
      match /messages/{messageId} {
        allow read, create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    // --- Messages: only conversation participants can read/write ---
    match /messages/{messageId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.resource.data.sender_id == request.auth.uid && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null && resource.data.sender_id == request.auth.uid;
      allow delete: if request.auth != null && resource.data.sender_id == request.auth.uid;
    }

    // --- Calls: participants only ---
    match /calls/{callId} {
      allow read: if request.auth != null && (resource.data.caller_id == request.auth.uid || resource.data.callee_id == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.caller_id == request.auth.uid;
      allow update: if request.auth != null && (resource.data.caller_id == request.auth.uid || resource.data.callee_id == request.auth.uid);
      allow delete: if false;
    }

    // --- Call Signals: participants only ---
    match /call_signals/{signalId} {
      allow read: if request.auth != null && (resource.data.from_user == request.auth.uid || resource.data.to_user == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from_user == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // --- Push Tokens: owner read/write ---
    match /push_tokens/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --- Unread Counts: owner read/write ---
    match /unread_counts/{countId} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow write: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    // --- Notifications: owner read, system write ---
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }

    // --- Admin Audit Logs: admin only ---
    match /admin_audit_logs/{logId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // --- Mutes: owner read/write ---
    match /mutes/{muteId} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow write: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    // --- Blocks: owner read/write ---
    match /blocks/{blockId} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow write: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    // --- Reports: authenticated create, admin read ---
    match /reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.reporter_id == request.auth.uid;
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow update: if request.auth != null && request.auth.token.admin == true;
      allow delete: if false;
    }

    // --- Payment Settings: public read, admin write ---
    match /payment_settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // --- Creator Subscriptions: authenticated read ---
    match /creator_subscriptions/{subId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
